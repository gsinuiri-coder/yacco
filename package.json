{
  "name": "yacco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @yacco/api dev",
    "dev:web-nuxt": "pnpm --filter @yacco/web-nuxt dev",
    "lint": "pnpm -r lint && pnpm exec eslint scripts",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "relay": "node scripts/relay.mjs",
    "test:integration": "pnpm -r test:integration",
    "build": "pnpm -r build",
    "prisma:validate": "pnpm --filter @yacco/api prisma:validate",
    "prisma:migrate": "pnpm --filter @yacco/api prisma:migrate",
    "db:seed": "pnpm --filter @yacco/api db:seed",
    "db:deploy": "pnpm --filter @yacco/api db:deploy",
    "demo:up": "docker compose up -d --wait postgres && pnpm db:deploy && pnpm db:seed",
    "demo:data": "pnpm --filter @yacco/api demo:data",
    "env:check": "node scripts/env-check.mjs",
    "env:local": "node scripts/env-local.mjs",
    "secrets:generate": "node scripts/secrets-generate.mjs",
    "gcp:bootstrap": "node scripts/gcp-bootstrap.mjs",
    "gcp:audit": "node scripts/gcp-audit.mjs",
    "secrets:gcp": "node scripts/secrets-gcp.mjs",
    "deploy:api": "node scripts/deploy-api.mjs",
    "deploy:web": "node scripts/deploy-web.mjs",
    "smoke:prod": "node scripts/smoke.mjs",
    "viewer:bootstrap": "node scripts/viewer-bootstrap.mjs",
    "roster:zones": "node scripts/roster-zones.mjs",
    "prepare": "husky",
    "test:e2e": "pnpm --filter @yacco/web-nuxt test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "typescript-eslint": "^8.71.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ggr8-5vv4-36mx",
        "GHSA-86w9-cpqp-85rv",
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-x6jw-m9v5-85vh",
        "GHSA-g4wm-2vf7-vfgr",
        "GHSA-858h-whjf-mvg5",
        "GHSA-v5rq-49vh-5v5c"
      ]
    },
    "overrides": {
      "multer": "^2.3.0",
      "js-yaml@3": "^3.15.2",
      "qs@6": "^6.16.0",
      "fontless>esbuild": "^0.28.1",
      "@nuxt/nitro-server>devalue": "^5.9.3"
    },
    "packageExtensions": {
      "@testing-library/jest-dom": {
        "peerDependencies": {
          "vitest": "*"
        },
        "peerDependenciesMeta": {
          "vitest": {
            "optional": true
          }
        }
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.vue": [
      "prettier --write"
    ]
  }
}
