{
  "permissions": {
    "allow": ["Bash(gcloud:*)", "Bash(vercel:*)", "Bash(neonctl:*)", "Bash(gh:*)"],
    "deny": ["Bash(neonctl branches delete:*)", "Bash(gcloud projects delete:*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-dangerous.sh\""
          }
        ]
      }
    ]
  }
}
