// Yacco — data model per spec §3.5 (docs/yacco-documentacion.md).
// Prisma names: PascalCase models / camelCase fields; DB stays snake_case
// (plural tables) via @map/@@map. Money is NUMERIC(10,2); event timestamps
// are timestamptz (UTC); business days are calendar dates (America/Lima at
// the edges). CHECK constraints and the partial FIFO index live in the
// migration SQL — Prisma cannot express them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer, transaction mode) — used by PrismaClient at runtime.
  url       = env("DATABASE_URL")
  // Unpooled — used only by Prisma Migrate/introspection, which need DDL
  // locking guarantees a transaction-mode pooler can't provide.
  directUrl = env("DIRECT_URL")
}

// --- Enums ------------------------------------------------------------------

enum UserRole {
  ADMIN
  SELLER
  DRIVER

  @@map("user_role")
}

enum ProductType {
  REFILL
  CONTAINER_SALE

  @@map("product_type")
}

enum ContainerMovementType {
  FLEET_ENTRY
  FILLING
  ROUTE_LOAD
  LOAN_DELIVERY
  EMPTY_PICKUP
  FULL_RETURN
  EMPTY_UNLOAD
  FULL_SALE
  DAMAGE_WRITE_OFF
  LOSS_WRITE_OFF
  OPENING_BALANCE
  COUNT_ADJUSTMENT
  // Las tres anulaciones: no registran que algo se haya movido, registran que
  // algo que se anotó NO pasó. Son tipos propios y no pares nuevos sobre los
  // tipos que anulan porque la liquidación agrega por `type`, no por estados
  // — una reversa tipada LOAN_DELIVERY sumaría a fullDelivered en vez de
  // restarle. Ver container-movement-transitions.ts.
  LOAN_DELIVERY_VOID
  EMPTY_PICKUP_VOID
  FULL_SALE_VOID

  @@map("container_movement_type")
}

// The five places a container can be, inside or at the edge of the fleet.
// "On route" splits full/empty because the truck carries both at once: a
// single ON_ROUTE bucket would let unloading more empties than were picked up
// balance out arithmetically, hiding a shortage the settlement must catch.
enum ContainerState {
  EMPTY_AT_PLANT
  FULL_AT_PLANT
  FULL_ON_ROUTE
  EMPTY_ON_ROUTE
  WITH_CUSTOMER

  @@map("container_state")
}

enum OrderStatus {
  PENDING
  ON_ROUTE
  DELIVERED
  FAILED
  CANCELLED

  @@map("order_status")
}

enum RouteStatus {
  PLANNED
  IN_PROGRESS
  FINISHED
  SETTLED

  @@map("route_status")
}

enum StopStatus {
  PENDING
  DELIVERED
  FAILED

  @@map("stop_status")
}

enum StopOrigin {
  ORDER
  VAN_SALE

  @@map("stop_origin")
}

enum SyncOperationStatus {
  APPLIED
  DUPLICATE
  REJECTED

  @@map("sync_operation_status")
}

// A payment born from a method that doesn't require confirmation (cash) is
// CONFIRMED immediately; one from a method that does (Yape, tomorrow Plin)
// is PENDING until someone at the office confirms seeing it land. A PENDING
// payment never reduces a customer's debt in any balance/report — the money
// hasn't been verified yet. REJECTED is the office's other resolution: they
// checked and the money never landed — the driver misread the app, the
// transfer bounced, whatever the reason. It has nothing to revert: a PENDING
// payment never touched debtBalance in the first place, so rejecting one is
// a pure record of the finding, not a correction.
enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED

  @@map("payment_status")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("weekday")
}

// --- Security & catalogs ----------------------------------------------------

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  username     String   @unique
  passwordHash String   @map("password_hash")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles                         UserRoleAssignment[]
  productionBatches             ProductionBatch[]
  containerMovements            ContainerMovement[]
  containerCounts               ContainerCount[]
  orders                        Order[]
  routesAsDriver                Route[]              @relation("RouteDriver")
  routesCreated                 Route[]              @relation("RouteCreatedBy")
  routeStopsAdded               RouteStop[]          @relation("RouteStopAddedBy")
  routeStopsCorrected           RouteStop[]          @relation("RouteStopCorrectedBy")
  salesRecorded                 Sale[]               @relation("SaleRecordedBy")
  salesPriceOverridesAuthorized Sale[]               @relation("SalePriceOverrideAuthorizedBy")
  salesVoided                   Sale[]               @relation("SaleVoidedBy")
  paymentsRecorded              Payment[]            @relation("PaymentRecordedBy")
  paymentsConfirmed             Payment[]            @relation("PaymentConfirmedBy")
  paymentsRejected              Payment[]            @relation("PaymentRejectedBy")
  paymentsVoided                Payment[]            @relation("PaymentVoidedBy")
  routeSettlements              RouteSettlement[]
  syncOperations                SyncOperation[]

  @@map("users")
}

model Role {
  id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name UserRole @unique

  users UserRoleAssignment[]

  @@map("roles")
}

model UserRoleAssignment {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Zone {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String    @unique
  deliveryDays Weekday[] @map("delivery_days")
  active       Boolean   @default(true)

  customers Customer[]
  routes    Route[]

  @@map("zones")
}

model ContainerType {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String  @unique
  active Boolean @default(true)

  products   Product[]
  batchItems BatchItem[]
  movements  ContainerMovement[]
  balances   CustomerContainerBalance[]
  counts     ContainerCount[]

  @@map("container_types")
}

model PaymentMethod {
  id                   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String  @unique
  active               Boolean @default(true)
  // Cash is counted by the driver and is firm the moment it's collected; a
  // Yape/Plin only the owner can see land on their phone, so it stays
  // PENDING until someone at the office confirms it. A catalog field, not a
  // hardcoded method name, so tomorrow's Plin needs no code change.
  requiresConfirmation Boolean @default(false) @map("requires_confirmation")

  payments Payment[]

  @@map("payment_methods")
}

// --- Customers & products ---------------------------------------------------

// Contact/address fields live only on CustomerLocation now: a customer with
// several locations would otherwise have two copies of "the address" (this
// row and its primary location) that can silently drift apart. Credit limit
// and debt stay here — spec: consolidated at the customer, never per location.
model Customer {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoneId       String?  @map("zone_id") @db.Uuid
  name         String
  creditLimit  Decimal? @map("credit_limit") @db.Decimal(10, 2)
  debtBalance  Decimal  @default(0) @map("debt_balance") @db.Decimal(10, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Set only by the roster loader (tools/firestore-export's output feeds
  // it), never through the public API — see CreateCustomerDto/UpdateCustomerDto.
  // Nullable: a customer created from the web has no external system to key
  // off. @unique on a nullable column is enough on its own — Postgres excludes
  // NULL from a UNIQUE constraint's duplicate check, so any number of
  // web-created customers can share externalCode = NULL — no hand-written
  // partial index needed here (contrast customer_locations_one_primary_per_customer
  // below, which partials over a NOT NULL boolean and has no such shortcut).
  externalCode String?  @unique @map("external_code")

  zone      Zone?              @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  locations CustomerLocation[]
  prices    CustomerPrice[]
  payments  Payment[]

  @@map("customers")
}

// A customer can have several physical locations; everything the truck or
// the ledger touches (orders, route stops, container movements/balances,
// sales) hangs off the location where it actually happens, never off the
// customer directly. Exactly one location per customer is primary — enforced
// by a partial unique index in the migration SQL (Prisma cannot express a
// partial index in the schema).
model CustomerLocation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String   @map("customer_id") @db.Uuid
  name             String
  address          String
  addressReference String   @map("address_reference")
  phone            String
  isPrimary        Boolean  @default(false) @map("is_primary")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Same reasoning as Customer.externalCode above: loader-only, nullable,
  // and @unique alone already lets every web-created location share NULL.
  externalCode     String?  @unique @map("external_code")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  prices     CustomerPrice[]
  balances   CustomerContainerBalance[]
  movements  ContainerMovement[]
  counts     ContainerCount[]
  orders     Order[]
  routeStops RouteStop[]
  sales      Sale[]
  payments   Payment[]

  @@map("customer_locations")
}

model Product {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  containerTypeId String      @map("container_type_id") @db.Uuid
  name            String
  type            ProductType
  listPrice       Decimal     @map("list_price") @db.Decimal(10, 2)
  active          Boolean     @default(true)

  containerType  ContainerType   @relation(fields: [containerTypeId], references: [id], onDelete: Restrict)
  customerPrices CustomerPrice[]
  orderItems     OrderItem[]
  saleItems      SaleItem[]

  @@map("products")
}

// The price agreement is with the customer; `locationId` is an optional
// override for one branch. The old (customerId, productId) composite key is
// gone: that pair alone can no longer be unique once a location-specific row
// can coexist with the customer-wide one, so this has a surrogate id instead
// — see the two partial unique indexes (one per tier) in the migration SQL.
model CustomerPrice {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String  @map("customer_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  locationId String? @map("location_id") @db.Uuid
  price      Decimal @db.Decimal(10, 2)

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  location CustomerLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@map("customer_prices")
}

// --- Production -------------------------------------------------------------

model ProductionBatch {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String   @unique
  date       DateTime @db.Date
  filledById String   @map("filled_by") @db.Uuid
  notes      String?

  filledBy  User                @relation(fields: [filledById], references: [id], onDelete: Restrict)
  items     BatchItem[]
  movements ContainerMovement[]

  @@map("production_batches")
}

model BatchItem {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId         String @map("batch_id") @db.Uuid
  containerTypeId String @map("container_type_id") @db.Uuid
  producedQty     Int    @map("produced_qty")
  availableQty    Int    @map("available_qty")

  batch         ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  containerType ContainerType   @relation(fields: [containerTypeId], references: [id], onDelete: Restrict)
  routeLoads    RouteLoad[]

  @@map("batch_items")
}

// --- Container ledger -------------------------------------------------------

// Immutable ledger: never UPDATE/DELETE; corrections are inverse movements.
// `fromState`/`toState` make the direction of every movement explicit rather
// than deducing it from `type` — a type alone stopped determining it once
// damage could happen both at the plant and on the route, and a sale could
// leave from either place too. Null on one side means the container is
// crossing the fleet's boundary: no `fromState` is a fleet entry, no
// `toState` is an exit (sale, damage, loss). Both null at once is not a
// movement at all — see the `container_movements_state_check` CHECK
// constraint (hand-written migration SQL; Prisma cannot express it).
model ContainerMovement {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt      DateTime              @map("occurred_at") @db.Timestamptz(6)
  type            ContainerMovementType
  containerTypeId String                @map("container_type_id") @db.Uuid
  quantity        Int
  fromState       ContainerState?       @map("from_state")
  toState         ContainerState?       @map("to_state")
  locationId      String?               @map("location_id") @db.Uuid
  batchId         String?               @map("batch_id") @db.Uuid
  // Set only on ROUTE_LOAD (and its FULL_RETURN reversal, if the load is
  // corrected before the truck leaves): a load isn't tied to any one stop,
  // and with two routes running at once, `toState = FULL_ON_ROUTE` alone
  // can't say which truck a given container is actually on. Every other
  // movement type leaves this null.
  routeId         String?               @map("route_id") @db.Uuid
  stopId          String?               @map("stop_id") @db.Uuid
  recordedById    String                @map("recorded_by") @db.Uuid

  containerType  ContainerType     @relation(fields: [containerTypeId], references: [id], onDelete: Restrict)
  location       CustomerLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  batch          ProductionBatch?  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  route          Route?            @relation(fields: [routeId], references: [id], onDelete: Restrict)
  stop           RouteStop?        @relation(fields: [stopId], references: [id], onDelete: Restrict)
  recordedBy     User              @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  containerCount ContainerCount?

  @@index([locationId, occurredAt])
  @@index([routeId, occurredAt])
  @@map("container_movements")
}

// Materialized from container_movements in the same transaction; always
// reconstructible from the ledger. Lives at the location, not the customer:
// containers sit at one physical address, with no customer-wide tier to
// preserve — unlike CustomerPrice, this is a straight move, not an override.
model CustomerContainerBalance {
  locationId      String @map("location_id") @db.Uuid
  containerTypeId String @map("container_type_id") @db.Uuid
  quantity        Int    @default(0)

  location      CustomerLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  containerType ContainerType    @relation(fields: [containerTypeId], references: [id], onDelete: Restrict)

  @@id([locationId, containerTypeId])
  @@map("customer_container_balances")
}

// Append-only record of a physical count at a customer location — never
// updated or deleted, same rule as container_movements. `expectedQuantity`
// is a deliberate snapshot of what CustomerContainerBalance held the moment
// of the count, not something re-derived later: it is the evidence of the
// discrepancy on that date, and the balance keeps moving after the count, so
// re-reading it later would erase what the count actually found.
// `adjustmentId` is null when the count matched the balance exactly — no
// COUNT_ADJUSTMENT is emitted for a zero delta (see ContainerCountsService).
model ContainerCount {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId       String   @map("location_id") @db.Uuid
  containerTypeId  String   @map("container_type_id") @db.Uuid
  countedAt        DateTime @map("counted_at") @db.Timestamptz(6)
  countedQuantity  Int      @map("counted_quantity")
  expectedQuantity Int      @map("expected_quantity")
  adjustmentId     String?  @unique @map("adjustment_id") @db.Uuid
  countedById      String   @map("counted_by") @db.Uuid

  location      CustomerLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  containerType ContainerType      @relation(fields: [containerTypeId], references: [id], onDelete: Restrict)
  adjustment    ContainerMovement? @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  countedBy     User               @relation(fields: [countedById], references: [id], onDelete: Restrict)

  @@index([locationId, containerTypeId, countedAt])
  @@map("container_counts")
}

// --- Orders & routes --------------------------------------------------------

model Order {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId   String      @map("location_id") @db.Uuid
  deliveryDate DateTime    @map("delivery_date") @db.Date
  status       OrderStatus @default(PENDING)
  createdById  String      @map("created_by") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  location  CustomerLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     OrderItem[]
  routeStop RouteStop?

  @@index([status, deliveryDate])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model Route {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date        DateTime    @db.Date
  driverId    String      @map("driver_id") @db.Uuid
  zoneId      String?     @map("zone_id") @db.Uuid
  status      RouteStatus @default(PLANNED)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String      @map("created_by") @db.Uuid

  driver     User                @relation("RouteDriver", fields: [driverId], references: [id], onDelete: Restrict)
  createdBy  User                @relation("RouteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  zone       Zone?               @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  loads      RouteLoad[]
  stops      RouteStop[]
  movements  ContainerMovement[]
  settlement RouteSettlement?

  // One route per driver per day: a second POST for the same pair is a
  // mistake (double planning), never a legitimate second route.
  @@unique([driverId, date])
  @@map("routes")
}

// Consumes batch_items strictly FIFO (oldest production_batches.date first).
model RouteLoad {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId     String @map("route_id") @db.Uuid
  batchItemId String @map("batch_item_id") @db.Uuid
  quantity    Int

  route     Route     @relation(fields: [routeId], references: [id], onDelete: Restrict)
  batchItem BatchItem @relation(fields: [batchItemId], references: [id], onDelete: Restrict)

  @@map("route_loads")
}

model RouteStop {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId       String     @map("route_id") @db.Uuid
  locationId    String     @map("location_id") @db.Uuid
  position      Int
  origin        StopOrigin
  orderId       String?    @unique @map("order_id") @db.Uuid
  status        StopStatus @default(PENDING)
  failureReason String?    @map("failure_reason")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  addedById     String     @map("added_by") @db.Uuid

  /// Las tres guardan SOLO LA ÚLTIMA corrección de esta parada: una segunda
  /// corrección las pisa. Es deliberado — la historia completa vive en las
  /// ventas anuladas y en el libro de movimientos. Ver `RoutesService.correctStop`.
  correctedAt      DateTime? @map("corrected_at") @db.Timestamptz(6)
  correctedById    String?   @map("corrected_by") @db.Uuid
  correctionReason String?   @map("correction_reason")

  route       Route               @relation(fields: [routeId], references: [id], onDelete: Restrict)
  location    CustomerLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  addedBy     User                @relation("RouteStopAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  correctedBy User?               @relation("RouteStopCorrectedBy", fields: [correctedById], references: [id], onDelete: Restrict)
  movements   ContainerMovement[]
  sales       Sale[]
  payments    Payment[]
  evidences   Evidence[]

  @@index([routeId, position])
  @@map("route_stops")
}

// --- Sales & collections ----------------------------------------------------

model Sale {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId                  String    @map("location_id") @db.Uuid
  stopId                      String?   @map("stop_id") @db.Uuid
  soldAt                      DateTime  @map("sold_at") @db.Timestamptz(6)
  total                       Decimal   @db.Decimal(10, 2)
  creditLimitExceeded         Boolean   @default(false) @map("credit_limit_exceeded")
  // Marks the charge that carries the customer's debt from the paper ledger
  // into the system at cutover. It is not a sale: it has no items, because
  // nobody knows what was actually sold to produce that debt, and faking
  // products would be worse than leaving it empty. It DOES count in the
  // customer's account statement — it is real debt — but never in a cash
  // reconciliation, a route settlement, or a products-sold report: that
  // money and those products moved before the system existed, and counting
  // them would throw off the day's own numbers.
  isOpeningBalance            Boolean   @default(false) @map("is_opening_balance")
  // Reference to the record in the system this row was imported from (the
  // roster loader's source). Unique when present — hand-written partial
  // index sales_external_id_key — so a second run of the loader finds the
  // charge it already created instead of creating it again. Null for every
  // sale the system itself registers: those come from no import.
  externalId                  String?   @map("external_id")
  recordedById                String    @map("recorded_by") @db.Uuid
  // Who authorized charging a price different from the one CustomerPrices
  // would have resolved. Required by the service whenever the caller's
  // unitPrice disagrees with the resolved one — the sale is never blocked,
  // but an unauthorized override is (spec: alert without blocking is only
  // for credit limit and container shortfalls, not for who OK'd a price).
  priceOverrideAuthorizedById String?   @map("price_override_authorized_by") @db.Uuid
  // La anulación de un cargo mal anotado. La fila NUNCA se edita ni se borra
  // (CLAUDE.md): estas tres columnas la marcan como anulada y todo lo que
  // suma dinero deja de contarla, mientras la fila original sigue ahí con su
  // monto para que el estado de cuenta la muestre en cero. Las tres van
  // juntas o ninguna — CHECK escrito a mano en la migración, Prisma no sabe
  // expresarlo.
  voidedAt                    DateTime? @map("voided_at") @db.Timestamptz(6)
  voidedById                  String?   @map("voided_by") @db.Uuid
  voidReason                  String?   @map("void_reason")

  location                  CustomerLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  stop                      RouteStop?       @relation(fields: [stopId], references: [id], onDelete: Restrict)
  recordedBy                User             @relation("SaleRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  priceOverrideAuthorizedBy User?            @relation("SalePriceOverrideAuthorizedBy", fields: [priceOverrideAuthorizedById], references: [id], onDelete: Restrict)
  voidedBy                  User?            @relation("SaleVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  items                     SaleItem[]
  payments                  Payment[]

  @@map("sales")
}

model SaleItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId    String  @map("sale_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("sale_items")
}

// Always tied to a customer; the location is optional — spec: with a
// location, that branch's manager settles their own debt; without one, the
// principal pays at the customer's consolidated level.
model Payment {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String        @map("customer_id") @db.Uuid
  locationId       String?       @map("location_id") @db.Uuid
  saleId           String?       @map("sale_id") @db.Uuid
  stopId           String?       @map("stop_id") @db.Uuid
  paymentMethodId  String        @map("payment_method_id") @db.Uuid
  paidAt           DateTime      @map("paid_at") @db.Timestamptz(6)
  amount           Decimal       @db.Decimal(10, 2)
  // Cash lands CONFIRMED with confirmedAt = paidAt (the driver counted it,
  // it's firm). A method with requiresConfirmation lands PENDING with both
  // null, until the office confirms seeing it. Every balance/report that
  // sums a customer's paid amount MUST filter status = CONFIRMED — a
  // PENDING payment hasn't been verified and never reduces debt.
  status           PaymentStatus @default(CONFIRMED)
  confirmedAt      DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  confirmedById    String?       @map("confirmed_by") @db.Uuid
  // The office's other resolution for a PENDING payment: checked, and the
  // money never landed. Nothing to revert — see the enum comment — so there
  // is no balance-side effect here, only the record of when, who, and why.
  rejectedAt       DateTime?     @map("rejected_at") @db.Timestamptz(6)
  rejectedById     String?       @map("rejected_by") @db.Uuid
  rejectionReason  String?       @map("rejection_reason")
  // Marks the credit that carries the customer's favorable balance from the
  // paper ledger into the system at cutover — an advance or an un-returned
  // change, never a prepayment plan (decided with the plant owner). It is
  // not a collection made today: that money came in months before the
  // system existed. It DOES count in the customer's account statement — a
  // real credit — but never in a cash reconciliation, a route settlement,
  // or a products-sold report, for the same reason as isOpeningBalance on
  // Sale.
  isOpeningBalance Boolean       @default(false) @map("is_opening_balance")
  recordedById     String        @map("recorded_by") @db.Uuid
  // Client-generated UUID v4, set only by POST /payments when the caller
  // sends one, so a network retry replays the same row instead of creating
  // a second one. Optional and unique: existing rows have none, and a
  // markStop-created payment doesn't need one — that write is already
  // idempotent through RouteStop's own `WHERE status = 'PENDING'` guard
  // (see RoutesService.markStopDelivered). Postgres excludes NULL from a
  // UNIQUE constraint's duplicate check, so any number of keyless payments
  // coexist with the keyed ones.
  idempotencyKey   String?       @unique @map("idempotency_key") @db.Uuid
  // La anulación de un cobro mal anotado, y NO es PaymentStatus.REJECTED:
  // rechazar dice que el dinero nunca llegó y por eso no hay nada que
  // revertir (ver el comentario del enum), mientras que el efectivo de una
  // entrega mal anotada sí tocó debtBalance y sí hay que devolverlo. Estas
  // columnas viven acá y no se leen de la venta: un pago existe sin venta
  // —la cobranza de oficina— y cada fila del libro se explica sola.
  voidedAt         DateTime?     @map("voided_at") @db.Timestamptz(6)
  voidedById       String?       @map("voided_by") @db.Uuid
  voidReason       String?       @map("void_reason")

  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  location      CustomerLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  sale          Sale?             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  stop          RouteStop?        @relation(fields: [stopId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod     @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  recordedBy    User              @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  confirmedBy   User?             @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  rejectedBy    User?             @relation("PaymentRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)
  voidedBy      User?             @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([paidAt, paymentMethodId])
  // The office collection screen (HU-18) loads a customer's recent payments
  // the moment it's picked — without this, filtering GET /payments by
  // customerId scans the whole table.
  @@index([customerId, paidAt(sort: Desc)])
  @@map("payments")
}

// A settlement with a mismatch still closes: the difference and its reason
// are recorded in notes; it never blocks.
model RouteSettlement {
  routeId                  String   @id @map("route_id") @db.Uuid
  fullOut                  Int      @map("full_out")
  fullDelivered            Int      @map("full_delivered")
  fullSold                 Int      @map("full_sold")
  fullReturned             Int      @map("full_returned")
  emptiesCollected         Int      @map("empties_collected")
  totalSold                Decimal  @map("total_sold") @db.Decimal(10, 2)
  // totalCollected predates PaymentStatus and keeps meaning the WHOLE amount
  // collected — cash the driver holds plus any Yape that might still be
  // unconfirmed — so HU-17's identity (totalSold = totalCollected +
  // totalOnCredit) stays exact. Nobody can count cash against that number,
  // which is why these two columns split it: totalCashCollected is what the
  // driver hands over physically; totalPendingConfirmation is the slice that
  // can still evaporate once the office resolves it (see #66).
  totalCollected           Decimal  @map("total_collected") @db.Decimal(10, 2)
  totalCashCollected       Decimal  @map("total_cash_collected") @db.Decimal(10, 2)
  totalPendingConfirmation Decimal  @map("total_pending_confirmation") @db.Decimal(10, 2)
  totalOnCredit            Decimal  @map("total_on_credit") @db.Decimal(10, 2)
  notes                    String?
  settledById              String   @map("settled_by") @db.Uuid
  settledAt                DateTime @map("settled_at") @db.Timestamptz(6)

  route     Route @relation(fields: [routeId], references: [id], onDelete: Restrict)
  settledBy User  @relation(fields: [settledById], references: [id], onDelete: Restrict)

  @@map("route_settlements")
}

// --- Support ----------------------------------------------------------------

model Evidence {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stopId     String   @map("stop_id") @db.Uuid
  objectKey  String   @map("object_key")
  capturedAt DateTime @map("captured_at") @db.Timestamptz(6)
  synced     Boolean  @default(false)

  stop RouteStop @relation(fields: [stopId], references: [id], onDelete: Restrict)

  @@map("evidences")
}

// id is the device-generated UUID (idempotency key) — no DB default.
model SyncOperation {
  id              String              @id @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  operationType   String              @map("operation_type")
  payload         Json
  clientTimestamp DateTime            @map("client_timestamp") @db.Timestamptz(6)
  appliedAt       DateTime            @default(now()) @map("applied_at") @db.Timestamptz(6)
  status          SyncOperationStatus

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("sync_operations")
}
