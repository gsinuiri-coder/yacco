{
  "name": "@yacco/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage"
  },
  "dependencies": {
    "@yacco/shared": "workspace:*",
    "expo": "~58.0.17",
    "expo-crypto": "~58.0.7",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.13",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "test-renderer": "1.3.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts?(x)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ]
  }
}
