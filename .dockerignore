# Lo que NO viaja al contexto de build de Docker.
#
# node_modules es el importante: son cientos de miles de archivos que el
# daemon copiaría antes de empezar, y que la imagen reinstala igual desde el
# lockfile. Sin esta línea el build tarda minutos en no hacer nada.
node_modules
**/node_modules

# Salidas de build: la imagen compila lo suyo.
dist
**/dist
build
**/build
coverage
**/coverage

# Credenciales. No deberían entrar nunca en una imagen, y menos en una capa,
# donde quedan aunque un paso posterior las borre.
.env
.env.*
!.env.example
!.env.setup.example

# El archivo de credenciales que escribe google-github-actions/auth en el
# workspace del runner (gha-creds-*.json). El build de la imagen corre en ese
# mismo checkout, así que sin esta línea la credencial de corta vida del
# deployer entraría al contexto y podría quedar en una capa publicada en
# Artifact Registry.
gha-creds-*.json

# Historia y metadatos que la imagen no usa.
.git
.github
.husky
.claude
.agents
.impeccable
docs

# El resto del monorepo que la API no necesita.
apps/mobile
design-kit
tools

# Ruido local.
*.log
.DS_Store
.vscode
docker-compose.override.yml
