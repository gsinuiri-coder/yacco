# apps/api
# 3000 suele estar ocupado por otros proyectos en la máquina del
# desarrollador; este es el valor que espera el frontend local
# (apps/web/src/config.ts) por defecto.
PORT=3100

# Git commit of the running build, echoed by GET /health as `commit`. Render
# injects it by itself into the service environment (it is NOT declared in
# render.yaml on purpose: listing it there would turn an automatic variable
# into a manual one somebody has to keep in sync). Left empty locally on
# purpose: /health then reports null, never a value guessed from git.
RENDER_GIT_COMMIT=
# Origins allowed by CORS (credentials enabled), as a comma-separated list —
# a single value still works, it is just a list of one. The list form exists
# so local development (the Vite dev server below) and a deployed frontend
# can both be allowed at once: pointing this only at the deployed origin
# would break running the app locally against production. Each value is
# trimmed; a stray or trailing comma never produces an empty origin.
#   WEB_ORIGIN=http://localhost:5173,https://app.yacco.pe
WEB_ORIGIN=http://localhost:5173

# PostgreSQL. Locally, both point at docker-compose's single Postgres
# instance. In production (Neon), they must be two different endpoints:
#   DATABASE_URL — the pooled endpoint (host has "-pooler"), used by
#     PrismaClient at runtime. pgbouncer=true is REQUIRED: Neon's pooler runs
#     PgBouncer in transaction mode, which does not support prepared
#     statements: without this flag Prisma fails intermittently and the
#     failure is hard to diagnose. connection_limit keeps each app instance
#     from exhausting the pooler's backend connections.
#     postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=10&connection_limit=5
#   DIRECT_URL — the unpooled endpoint (no "-pooler"), used only by Prisma
#     Migrate/introspection, which need DDL locking a transaction-mode
#     pooler can't provide.
#     postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require
# Si usás docker-compose.override.yml.example (Postgres nativo ocupando el
# 5432 de la máquina), copialo a docker-compose.override.yml y cambiá el
# puerto de estas dos URLs de 5432 a 5433.
DATABASE_URL=postgresql://yacco:yacco@localhost:5432/yacco_dev
DIRECT_URL=postgresql://yacco:yacco@localhost:5432/yacco_dev

# JWT (D-14: short-lived access + 30-day refresh for the driver app)
JWT_ACCESS_SECRET=changeme
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme
JWT_REFRESH_EXPIRES_IN=30d

# S3-compatible object storage (MinIO locally, Cloudflare R2 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=yacco-evidence
S3_ACCESS_KEY_ID=yacco
S3_SECRET_ACCESS_KEY=yacco12345
