# Plantilla de `.env.setup` — el archivo de credenciales de la MIGRACIÓN a
# Cloud Run + Vercel. Copiá esta plantilla a `.env.setup` y completá lo que
# falte:
#
#     cp .env.setup.example .env.setup
#     pnpm env:check        # dice qué falta, sin imprimir ningún valor
#
# `.env.setup` está ignorado por git (`.env.*` en .gitignore). Esta plantilla
# NO lo está, a propósito: es la única documentación de qué significa cada
# clave, y por eso no lleva ningún valor real.
#
# Ningún agente lee `.env.setup` directamente. Lo leen los scripts, siempre a
# través de `scripts/lib.mjs#readEnvFile`, que además registra cada valor
# secreto para tacharlo de cualquier salida de error.
#
# Varias claves son OPCIONALES en esta máquina porque el CLI correspondiente
# ya quedó logueado de forma interactiva (`gcloud auth login`, `gh auth
# login`, `vercel login`, `neonctl auth`). Los scripts usan el valor del
# archivo si está, y si no caen a la sesión del CLI. Se vuelven obligatorias
# cuando el script corre en un sitio sin esa sesión: tu CI, otra máquina.

# --- Google Cloud -----------------------------------------------------------

# Id del proyecto de GCP donde vive Cloud Run. Lo crea `pnpm gcp:bootstrap` si
# no existe. NO reutilizar `yacco-2026`: ese es el Yacco viejo sobre Firebase
# y Firestore (ver `tools/firestore-export/`), con ~40 APIs habilitadas que v2
# no necesita.
GCP_PROJECT_ID=

# Cuenta de facturación a la que se vincula el proyecto.
# Console > Facturación, formato XXXXXX-XXXXXX-XXXXXX. Se lista con
# `gcloud billing accounts list`.
GCP_BILLING_ACCOUNT_ID=

# Región de Cloud Run. NO es una preferencia: la base de datos es el camino
# caliente de cada request, así que esto se decide por cercanía a Neon.
# Ver la decisión D-002 en docs/ARQUITECTURA.md.
GCP_REGION=

# --- Vercel -----------------------------------------------------------------

# vercel.com > Account Settings > Tokens > Create. Scope: el team
# "gsinuiricoder's projects", donde vive el proyecto yacco-web.
# Obligatorio para CI: el deploy del web corre en GitHub Actions, donde no hay
# sesión de `vercel login`, y Vercel no acepta Workload Identity.
# NO va a los secretos de GitHub: `pnpm secrets:gcp` lo sube a Secret Manager
# (yacco-ci-vercel-token) sin imprimirlo, y CI lo lee de ahí por WIF (D-015).
# Sigue siendo de larga vida: se rota al cerrar la migración.
VERCEL_TOKEN=

# Sólo si el proyecto de Vercel vive dentro de un team en lugar de la cuenta
# personal. Vacío = cuenta personal.
VERCEL_TEAM_ID=

# --- Neon -------------------------------------------------------------------

# console.neon.tech > Account settings > API keys.
# Opcional en esta máquina: `neonctl` ya está autenticado.
NEON_API_KEY=

# Id del proyecto Neon existente (`neonctl projects list`). No se crea uno
# nuevo: la base de producción ya existe y la migración no la toca.
NEON_PROJECT_ID=

# Id de la organización dueña del proyecto. Sin esto `neonctl` abre un prompt
# interactivo para elegir organización y cuelga cualquier script.
NEON_ORG_ID=

# --- GitHub -----------------------------------------------------------------

# Fine-grained token con permisos de Secrets, Actions y Administration sobre
# este repo. Opcional en esta máquina: `gh` ya está autenticado por keyring.
GH_TOKEN=

# --- Render (sólo para el apagado de la fase 7) ------------------------------

# dashboard.render.com > Account Settings > API Keys. Sólo hace falta para
# suspender el servicio viejo al final, pasados los 7 días de convivencia.
RENDER_API_KEY=

# Id `srv-...` del servicio actual de la API en Render.
RENDER_SERVICE_ID=

# --- Secretos de la aplicación ----------------------------------------------

# NO los escribas a mano y NO los copies de Render: los genera
# `pnpm secrets:generate`, que los escribe acá sin imprimirlos. Son nuevos a
# propósito; rotarlos sólo invalida sesiones abiertas y hoy no hay usuarios
# reales.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Configuración, no secretos: cuánto dura cada token. Los valores de abajo son
# los que ya usa Render.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
